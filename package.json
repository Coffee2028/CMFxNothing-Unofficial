{
  "name": "nothing-ear-app",
  "productName": "CMFxNothing (Unofficial)",
  "version": "1.0.4",
  "description": "Unofficial desktop app for Nothing and CMF earbuds",
  "main": "main.js",
  "author": "Coffee",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.coffee.nothingx",
    "productName": "CMFxNothing (Unofficial)",
    "copyright": "AGPL-3.0. Unofficial app, not affiliated with Nothing Technology.",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "main.js",
      "electron/**",
      "resources/icon.png",
      "web/dist/**",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CMFxNothing (Unofficial)",
      "artifactName": "CMFxNothing-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "resources/icon-mac.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "CMFxNothing-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "CMFxNothing uses Bluetooth to connect to your earbuds.",
        "NSBluetoothPeripheralUsageDescription": "CMFxNothing uses Bluetooth to connect to your earbuds."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Coffee2028",
        "repo": "CMFxNothing-Unofficial"
      }
    ],
    "dmg": {
      "artifactName": "CMFxNothing-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
